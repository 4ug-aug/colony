# Keep this secret stable for persistent sessions.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Local browser GUI is on 3010; coordinator API on 3011 (avoids production on 3000/3001).
BETTER_AUTH_URL=http://localhost:3011
SWEAT_GUI_ORIGIN=http://localhost:3010
SWEAT_COORDINATOR_PORT=3011
SWEAT_SANDBOX_PROVIDER=apple-container
VITE_SWEAT_API_URL=http://localhost:3011

# Optional integrations and overrides
# LINEAR_MCP_API_KEY=
# ASANA_API_TOKEN=
# ASANA_PROJECT_GID=
# Outline wiki for antboy. Self-hosted: your own installation URL.
# API key scopes: documents:read documents:write collections:read
# OUTLINE_URL=https://yoursubdomain.getoutline.com
# OUTLINE_API_KEY=
# Optional remote Grafana MCP for antboy (streamable HTTP URL + bearer token).
# GRAFANA_MCP_URL=https://mcp.example.com/mcp
# GRAFANA_MCP_API_KEY=

# Authenticate the host GitHub CLI before enabling repository runs.
# SWEAT_GITHUB_REPOSITORY=owner/repository
# SWEAT_GITHUB_BASE=main
# Required to grant the agent pull-request publishing.
# SWEAT_VERIFY_COMMAND=
SWEAT_AGENT_IMAGE=ghcr.io/4ug-aug/sweat-v2-agent:latest
# Optional Cursor agent runtime image (Node 22.13+ / @cursor/sdk).
# SWEAT_CURSOR_AGENT_IMAGE=ghcr.io/4ug-aug/sweat-v2-agent-cursor:latest
# CA bundle installed inside agent containers.
# SWEAT_AGENT_CA_CERT=/absolute/path/to/company-ca.pem
# CA bundle the coordinator itself trusts, for integrations behind an internal
# CA (self-hosted Outline, Linear through a TLS-inspecting proxy). Without it,
# those upstreams fail with UNABLE_TO_VERIFY_LEAF_SIGNATURE. On Linux,
# `make service-install` hoists this into the systemd unit Environment=.
# NODE_EXTRA_CA_CERTS=/absolute/path/to/company-ca.pem
# SWEAT_MCP_HOST=http://host.container.internal
