{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "strict": true,
      "skipLibCheck": true,
      "noEmit": true,
      // Container runtimes run TypeScript directly (node --experimental-strip-types),
      // which requires the .ts extension on their imports.
      "allowImportingTsExtensions": true,
      "types": ["bun", "node"]
    },
    // Sources are reached transitively through index.ts. Tests are not checked:
    // widening to "./**/*.ts" is the goal, but 8 test files fail it today.
    "include": ["./*"]
  }
